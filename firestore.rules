rules_version = '2';

// Alleen jouw Google-account mag lezen en schrijven.
// Vervang JOUW_UID_HIER door de UID uit MySeasons > Meer > Instellingen > Account,
// en plak dit bestand in de Firebase console onder Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == 'JOUW_UID_HIER';
    }
  }
}
